# ==========================================
# Task Management REST API Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="Task Management REST API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL primary)
# For PostgreSQL (Production / Docker / Local PostgreSQL instance):
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/taskdb"
# For local development with SQLite (no external server required):
# DATABASE_URL="sqlite:///./taskmanagement.db"

# JWT Authentication
# IMPORTANT: Generate a new secret in production using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
